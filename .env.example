# Active provider: openai | gemini | cursor
AI_PROVIDER=openai

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2-chat-latest

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # alternative to GEMINI_API_KEY
# gemini-2.0-flash = Gemini 2 (often better free-tier limits than 2.5/3.5)
# gemini-2.5-flash-lite = lighter, higher RPM if 2.0 is unavailable
GEMINI_MODEL=gemini-2.0-flash
# Optional override (default is auto: ~6s for 2.0, ~15s for 2.5/3.x)
# GEMINI_MIN_INTERVAL_SEC=8

# Cursor Agent CLI (https://cursor.com/docs/cli/overview) — option 3 in start_backend.sh
# Install: curl https://cursor.com/install -fsS | bash
# CURSOR_API_KEY=          # required unless you ran: agent login
#                          # Get key: https://cursor.com/dashboard → Integrations
# CURSOR_AGENT_BIN=agent   # or cursor-agent if not on PATH
# CURSOR_AGENT_MODEL=composer-2
# CURSOR_AGENT_TIMEOUT_SEC=180
